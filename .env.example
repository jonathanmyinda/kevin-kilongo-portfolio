# Public identifier, NOT an API key. Fictitious placeholder; no sending by default.
VITE_FORMSPREE_FORM_ID=YOUR_FORM_ID
# Set true only AFTER recipient, server validation and antispam are configured.
VITE_CONTACT_SERVICE_READY=false

# Future API only; fictitious placeholders, no automatic connection.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXAMPLE_NOT_A_REAL_KEY
# Never prefix a secret with VITE_. Configure only in local/server environment.
SUPABASE_SECRET_KEY=sb_secret_EXAMPLE_NOT_A_REAL_KEY
LOCAL_DATABASE_URL=postgresql://example_user:example_password@127.0.0.1:54322/postgres

# Dedicated hosted development target ONLY. Copy into .env.supabase-dev.local.
# Placeholders deliberately invalid: no actual project is selected.
SUPABASE_DEV_PROJECT_REF=YOUR_DEV_PROJECT_REF
SUPABASE_DEV_PROJECT_NAME=kevin-portfolio-dev
SUPABASE_DEV_REGION=YOUR_SELECTED_REGION
SUPABASE_DEV_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
SUPABASE_DEV_PUBLISHABLE_KEY=sb_publishable_EXAMPLE_NOT_A_REAL_KEY
SUPABASE_DEV_SECRET_KEY=sb_secret_EXAMPLE_NOT_A_REAL_KEY
# Required by image validation/deletion API and local tools. Server only; never VITE_*.
# Optional local tools only. User chooses the real address; no automatic account creation.
SUPABASE_DEV_FIRST_ADMIN_EMAIL=admin@example.invalid
# Same-origin API CSRF check; override only for an explicitly selected future deployment.
ADMIN_ORIGIN=http://127.0.0.1:5173
# Database password: scripts/CLI process only, not a VITE_* variable.
SUPABASE_DB_PASSWORD=EXAMPLE_NOT_A_REAL_PASSWORD
